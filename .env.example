# Neon PostgreSQL Database URLs
# Pooled connection URL (typically on port 6543 for transactional connection pooling via pgbouncer)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection URL (typically on port 5432, used for Prisma migrations to bypass pooler limitations)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Next.js Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
